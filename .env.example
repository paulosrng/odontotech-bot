# ===== Google Calendar (obrigatório p/ agendamento) =====
# Caminho do arquivo JSON da Service Account baixado do Google Cloud
GOOGLE_CREDENTIALS_PATH=./credentials.json
# ID da agenda onde os eventos serão criados.
# Use "primary" se compartilhou a agenda principal, ou o ID da agenda (algo@group.calendar.google.com)
GOOGLE_CALENDAR_ID=primary
# Fuso horário da clínica (padrão IANA)
TIMEZONE=America/Sao_Paulo

# ===== Groq (OPCIONAL — cérebro de IA para perguntas fora do menu) =====
# Pegue grátis em https://console.groq.com/keys
# Se ficar vazio, o bot funciona normalmente só com o menu.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ===== Banco de dados =====
# Usa SQLite (arquivo local) — não precisa configurar nada.
# Opcional: mude o caminho/arquivo do banco se quiser.
# SQLITE_PATH=./odontotech.db

# ===== Horário de funcionamento (para sugerir slots) =====
CLINIC_OPEN_HOUR=9
CLINIC_CLOSE_HOUR=18
APPOINTMENT_DURATION_MIN=30
